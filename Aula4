class SpoolerImpressao:
    def __init__(self):
        self.fila_impressao = deque()

    def enfileirar_documento(self, documento):
        self.fila_impressao.append(documento)
        print(f"Documento '{documento}' adicionado ao final da fila.")

    def imprimir_proximo(self):
        if self.fila_impressao:
            documento = self.fila_impressao.popleft()
            print(f"Imprimindo o documento mais antigo: '{documento}'")
        else:
            print("A fila de impressão está vazia.")

impressora = SpoolerImpressao()
impressora.enfileirar_documento("Doc_1_Relatorio")
impressora.enfileirar_documento("Doc_2_Curriculo")
impressora.imprimir_proximo() # Vai imprimir o Doc_1_Relatorio

