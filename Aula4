# exercicio 1
class EditorTexto:
    def __init__(self):
        self.pilha_acoes = []

    def realizar_acao(self, acao):
        self.pilha_acoes.append(acao)
        print(f"Ação realizada e salva no topo: '{acao}'")

    def desfazer(self):
        if self.pilha_acoes:
            acao_revertida = self.pilha_acoes.pop()
            print(f"Desfazendo (Ctrl+Z): '{acao_revertida}'")
        else:
            print("Não há ações para desfazer.")

editor = EditorTexto()
editor.realizar_acao("digitar 'Ola'")
editor.realizar_acao("apagar 'a'")
editor.desfazer() 

