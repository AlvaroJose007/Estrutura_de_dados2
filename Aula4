class TriagemHospitalar:
    def __init__(self):
        self.fila_pacientes = deque()

    def adicionar_paciente_normal(self, nome):
        self.fila_pacientes.append(nome)
        print(f"Paciente normal '{nome}' aguardando no final da fila.")

    def adicionar_paciente_prioritario(self, nome):
        self.fila_pacientes.appendleft(nome)
        print(f"Atencao: Paciente Prioritário '{nome}' inserido no inicio da fila")

    def chamar_proximo_atendimento(self):
        if self.fila_pacientes:
            paciente = self.fila_pacientes.popleft()
            print(f"Chamando para o consultório: '{paciente}'")
        else:
            print("Nenhum paciente aguardando atendimento.")

triagem = TriagemHospitalar()
triagem.adicionar_paciente_normal("João")
triagem.adicionar_paciente_normal("Maria")
triagem.adicionar_paciente_prioritario("Sr. Antônio (Idoso)")
triagem.chamar_proximo_atendimento() # Vai chamar o Sr. Antônio primeiro
